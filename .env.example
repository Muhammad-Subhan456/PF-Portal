# Supabase (Project Settings → API)
# Use the Project URL only — do NOT append /rest/v1/
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here

# Owner emails that can sign in without a PUCIT address (comma-separated)
# Example: VITE_BOOTSTRAP_ADMIN_EMAILS=you@gmail.com
VITE_BOOTSTRAP_ADMIN_EMAILS=

# Optional: disable production console sanitizer
# VITE_DISABLE_CONSOLE_SANITIZER=true
